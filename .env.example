# ----------------------------------------------------------------------------
# Prio — environment configuration
#
# Copy this file to `.env` (only needed for `docker compose` variable
# substitution and for running outside Docker). Inside the containers the
# application's `.env` is generated automatically from these variables by the
# entrypoint, so you normally only edit values here.
# ----------------------------------------------------------------------------

# --- Web server -------------------------------------------------------------
# Host port the application is published on -> http://localhost:${APP_PORT}
APP_PORT=8080

# Application environment: local | production
APP_ENV=local

# Optional base path / full URL for future sub-directory or domain hosting.
# Leave empty when serving at the web root (the default Docker setup).
APP_BASE_PATH=
APP_URL=

# --- Database ---------------------------------------------------------------
# DB_SERVER is the hostname the PHP app uses to reach MySQL. Inside Docker this
# is the compose service name `db` (set automatically in docker-compose.yml).
DB_SERVER=db
DB_NAME=prio
DB_USERNAME=prio
DB_PASSWORD=prio_secret
DB_ROOT_PASSWORD=root_secret

# Host port to expose MySQL on (development override only).
DB_PORT=3306

# --- Encryption -------------------------------------------------------------
# AES-256-CBC key used to encrypt all stored data.
# IMPORTANT: This MUST stay constant. Data encrypted with one key cannot be
# decrypted with another. Generate a strong value for production, e.g.:
#   openssl rand -hex 16
ENCRYPTION_KEY=change_me_dev_key_0123456789abcd
