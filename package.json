{
  "name": "prio",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build pipeline for the Prio application",
  "scripts": {
    "build": "tailwindcss -i ./public/css/src/app.css -o ./public/css/app.css --minify",
    "watch": "tailwindcss -i ./public/css/src/app.css -o ./public/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.19",
    "fullcalendar": "^6.1.20",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  }
}
